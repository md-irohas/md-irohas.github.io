// Format details: https://aka.ms/devcontainer.json
{
    "name": "md-irohas.github.io (hugo)",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

    // Features: https://containers.dev/features
    "features": {
        "ghcr.io/devcontainers/features/hugo:1": {
            "version": "latest"
        }
    },

    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    "containerEnv": {
       "LANG": "C.UTF-8",
       "LC_ALL": "C.UTF-8"
    },
    // "remoteEnv": {},

    // "mounts": [
    // ],

    "forwardPorts": [
        1313    // Hugo default server port
    ]

    // Commands to run when the container is created
    // - onCreateCommand => environment setup that does not depend on the repository contents
    // - updateContentCommand => setup that runs after onCreateCommand, and again when the source is updated
    // - postCreateCommand => setup that depends on the repository contents or is user/project-specific
    // "onCreateCommand": {},
    // "updateContentCommand": {},
    // "postCreateCommand": {},

    // Commands to run after the container is started
    // "postStartCommand": {}

    // VS Code extensions to install.
    // "customizations": {
    //     "vscode": {
    //         "extensions": [
    //         ]
    //     }
    // }
}
